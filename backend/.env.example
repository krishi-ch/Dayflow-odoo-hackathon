# Copy this to .env in backend/ and edit keys you want to override
DATABASE_URL=postgresql+psycopg2://dayflow:dayflow@localhost:5432/dayflow_hrms
DATABASE_URL_ASYNC=postgresql+asyncpg://dayflow:dayflow@localhost:5432/dayflow_hrms
SECRET_KEY=dayflow-super-secret-key-change-in-production-please-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@dayflow.tech

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_SIZE_MB=10
PROFILE_PICTURES_DIR=uploads/profile_pictures
DOCUMENTS_DIR=uploads/documents
PAYSLIPS_DIR=uploads/payslips

WORK_START_HOUR=9
WORK_START_MINUTE=30
WORK_END_HOUR=18
WORK_END_MINUTE=0
LATE_THRESHOLD_MINUTES=15
HALF_DAY_THRESHOLD_HOURS=4.0
FULL_DAY_HOURS=8.0

# Optional: enable LLM-backed chat
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
